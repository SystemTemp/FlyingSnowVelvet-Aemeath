<Window
    x:Class="AemeathPet.WinUI.ChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="和飞行雪绒聊天" FontSize="24" FontWeight="SemiBold" />
        <ListView x:Name="MessageList" Grid.Row="1" Margin="0,12,0,12" />
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" PlaceholderText="输入消息..." />
            <Button Grid.Column="1" Content="发送" Click="SendButton_Click" />
        </Grid>
    </Grid>
</Window>
