<Window
    x:Class="AemeathPet.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
            <ToggleSwitch Header="窗口置顶" IsOn="True" />
            <ToggleSwitch Header="点击穿透" IsOn="False" />
            <TextBlock Text="缩放" />
            <Slider Minimum="0.5" Maximum="2.0" Value="1.0" />
            <TextBlock Text="角色资源" />
            <TextBox Text="default" />
            <Button Content="保存（占位）" />
        </StackPanel>
    </ScrollViewer>
</Window>
